---
interface Stat { value: string; label: string; }
interface Props {
  variant?: 'full' | 'compact';
  eyebrow?: string;
  title: string;
  sub?: string;
  /** Optional looping background video (muted, autoplay). Poster shown while loading / reduced motion. */
  video?: string;
  poster?: string;
  /** Full variant only: key numbers shown in a strip at the bottom of the hero. */
  stats?: Stat[];
  statsNote?: string;
}
const { variant = 'compact', eyebrow, title, sub, video, poster, stats, statsNote } = Astro.props;
---
<header class={`hero hero--${variant} ${video ? 'hero--video' : ''}`}>
  {video && (
    <video
      class="hero__video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={poster}
      aria-hidden="true"
    >
      <source src={video} type="video/mp4" />
    </video>
  )}
  <div class="hero__bg"></div>
  <div class="wrap hero__inner">
    {eyebrow && <span class="bracket-label">{eyebrow}</span>}
    <h1 class="hero__title" set:html={title}></h1>
    {sub && <p class="lead hero__sub">{sub}</p>}
    {variant === 'full' && (
      <div class="hero__cta">
        <a href="/products/" class="btn btn--primary">Our Products</a>
        <a href="/contact/" class="btn btn--ghost">Get in Touch</a>
      </div>
    )}
  </div>
  {variant === 'full' && stats && (
    <div class="hero__strip">
      <div class="wrap">
        <dl class="hero__stats">
          {stats.map((s) => (
            <div class="hero__stat">
              <dd>{s.value}</dd>
              <dt>{s.label}</dt>
            </div>
          ))}
        </dl>
        {statsNote && <p class="hero__note">{statsNote}</p>}
      </div>
    </div>
  )}
</header>

<style>
  .hero { position: relative; overflow: hidden; }
  .hero--full {
    min-height: 100vh; min-height: 100svh;
    display: flex; flex-direction: column;
    padding-top: calc(var(--nav-h) + clamp(2.5rem, 9vh, 6.5rem));
  }
  .hero--compact {
    padding: calc(var(--nav-h) + clamp(3.5rem, 9vw, 7.5rem)) 0 clamp(2.5rem, 5vw, 4rem);
  }

  .hero__video {
    position: absolute; left: 0; top: 10%; z-index: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: center 70%;
    pointer-events: none;
  }
  .hero__bg { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  /* Faint blueprint grid on heroes without video. Fades out to the right and down. */
  .hero:not(.hero--video) .hero__bg {
    background:
      linear-gradient(var(--line) 1px, transparent 1px) 0 calc(var(--nav-h) - 1px) / 80px 80px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 80px 80px;
    -webkit-mask-image: radial-gradient(120% 100% at 100% 0%, #000 0%, transparent 62%);
            mask-image: radial-gradient(120% 100% at 100% 0%, #000 0%, transparent 62%);
    opacity: 0.8;
  }
  /* Scrim over the video: dark at the top-left where the text sits, clear over Earth. */
  .hero--video .hero__bg {
    background:
      linear-gradient(180deg, rgba(6,6,7,0.72) 0%, rgba(6,6,7,0.28) 42%, rgba(6,6,7,0) 62%, rgba(6,6,7,0.55) 100%),
      linear-gradient(90deg, rgba(6,6,7,0.5) 0%, rgba(6,6,7,0) 55%);
  }
  .hero__inner { position: relative; z-index: 2; width: 100%; }

  /* One staggered load: eyebrow, title, sub, buttons rise in turn. */
  .hero__inner > *, .hero__strip { animation: hero-rise 1s var(--reveal-ease) backwards; }
  .hero__inner > :nth-child(2) { animation-delay: 0.1s; }
  .hero__inner > :nth-child(3) { animation-delay: 0.2s; }
  .hero__inner > :nth-child(4) { animation-delay: 0.3s; }
  .hero__strip { animation-delay: 0.45s; }
  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__video { display: none; }
    .hero--video { background: url('/images/earth-hero-poster.jpg') center 70% / cover no-repeat; }
    .hero__inner > *, .hero__strip { animation: none; }
  }

  .hero__title {
    font-size: var(--fs-hero);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.05em;
    max-width: 14ch;
    color: var(--text);
    text-wrap: initial;
  }
  .hero--compact .hero__title { font-size: var(--fs-page); line-height: 0.98; letter-spacing: -0.045em; max-width: 20ch; }
  .hero__sub { margin-top: clamp(1.25rem, 2.5vw, 2rem); color: var(--text); max-width: 46ch; text-shadow: 0 0 24px rgba(6,6,7,0.9); }
  .hero--compact .hero__sub { color: var(--text-muted); max-width: 58ch; }
  .hero__cta { margin-top: clamp(1.75rem, 3vw, 2.5rem); display: flex; gap: 0.75rem; flex-wrap: wrap; }

  /* Key-number strip pinned to the bottom of the full hero */
  .hero__strip {
    position: relative; z-index: 2; margin-top: auto;
    padding-top: clamp(3rem, 8vh, 6rem);
  }
  .hero__stats {
    display: grid; grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line-hi);
    background: rgba(6, 6, 7, 0.42);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
  }
  .hero__stat { padding: 1.1rem 1.25rem 1.2rem; border-left: 1px solid var(--line-hi); }
  .hero__stat:first-child { border-left: none; padding-left: 0; background: none; }
  .hero__stat dd {
    font-size: clamp(1.5rem, 2.8vw, 2.5rem); font-weight: 500; line-height: 1; letter-spacing: -0.04em; color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .hero__stat dt {
    margin-top: 0.55rem; font-family: var(--font-mono); font-size: var(--fs-label); font-weight: 500;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); line-height: 1.4;
  }
  .hero__note {
    font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: rgba(237, 233, 230, 0.6); padding: 0.75rem 0 1rem;
  }
  @media (max-width: 760px) {
    .hero__stats { grid-template-columns: repeat(2, 1fr); }
    .hero__stat:nth-child(odd) { border-left: none; padding-left: 0; }
    .hero__stat:nth-child(n + 3) { border-top: 1px solid var(--line-hi); }
  }
</style>
