---
interface Props {
  tag?: string;
  title: string;
  body: string;
}
const { tag, title, body } = Astro.props;
---
<div class="mcard reveal">
  {tag && <span class="mcard__tag">{tag}</span>}
  <h3 class="mcard__title">{title}</h3>
  <p class="mcard__body">{body}</p>
</div>

<style>
  .mcard {
    position: relative;
    padding: 1.6rem 1.6rem 2rem;
    min-height: 15rem;
    display: flex; flex-direction: column;
    transition: background 0.3s;
  }
  /* Orange tick that grows along the top edge on hover */
  .mcard::before {
    content: ''; position: absolute; left: 0; top: -1px; height: 1px; width: 1.6rem;
    background: var(--accent); transition: width 0.45s var(--reveal-ease);
  }
  .mcard:hover { background: var(--surface); }
  .mcard:hover::before { width: 100%; }
  .mcard__tag {
    font-family: var(--font-mono); font-size: var(--fs-label); font-weight: 500;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-dim);
    display: block; margin-bottom: auto; padding-bottom: 2.5rem;
  }
  @media (max-width: 640px) { .mcard { min-height: 0; } .mcard__tag { padding-bottom: 1.75rem; } }
  .mcard__title { font-size: clamp(1.25rem, 1.7vw, 1.5rem); letter-spacing: -0.02em; line-height: 1.12; margin-bottom: 0.7rem; }
  .mcard__body { font-size: var(--fs-sm); line-height: 1.55; color: var(--text-muted); max-width: 40ch; }
</style>
