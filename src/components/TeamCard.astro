---
interface Props {
  photo: string;
  name: string;
  role: string;
  bio: string;
}
const { photo, name, role, bio } = Astro.props;
---
<div class="tcard reveal">
  <img class="tcard__photo" src={photo} alt={name} loading="lazy" width="120" height="120" />
  <div class="tcard__role">{role}</div>
  <h3 class="tcard__name">{name}</h3>
  <p class="tcard__bio">{bio}</p>
</div>

<style>
  .tcard { padding: 1.6rem 1.6rem 2rem; transition: background 0.3s; }
  .tcard:hover { background: var(--surface); }
  .tcard__photo {
    width: 88px; height: 88px; display: block;
    object-fit: cover; object-position: top;
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.4s;
    margin-bottom: 2.25rem;
  }
  .tcard:hover .tcard__photo { filter: none; }
  .tcard__role {
    font-family: var(--font-mono); font-size: var(--fs-label); font-weight: 500;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.5rem;
  }
  .tcard__name { font-size: clamp(1.35rem, 1.9vw, 1.65rem); letter-spacing: -0.025em; margin-bottom: 0.85rem; }
  .tcard__bio { font-size: var(--fs-sm); line-height: 1.55; color: var(--text-muted); }
</style>
