---
interface Props {
  href: string;
  title: string;
  excerpt?: string;
  date?: string;   // human-readable
  image?: string;
}
const { href, title, excerpt, date, image } = Astro.props;
---
<a class="bcard reveal" href={href} target="_blank" rel="noopener">
  {image && (
    <div class="bcard__media">
      <img src={image} alt="" loading="lazy" decoding="async" />
    </div>
  )}
  <div class="bcard__body">
    {date && <span class="bcard__date">{date}</span>}
    <h3 class="bcard__title">{title}</h3>
    {excerpt && <p class="bcard__excerpt">{excerpt}</p>}
    <span class="bcard__more">Read post <span aria-hidden="true">→</span></span>
  </div>
</a>

<style>
  .bcard { display: flex; flex-direction: column; color: inherit; transition: background 0.3s; }
  .bcard:hover { background: var(--surface); }
  .bcard__media { aspect-ratio: 16 / 9; overflow: hidden; background: var(--surface); border-bottom: 1px solid var(--line); }
  .bcard__media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.7s var(--reveal-ease); }
  .bcard:hover .bcard__media img { transform: scale(1.04); }
  .bcard__body { padding: 1.5rem 1.6rem 1.75rem; display: flex; flex-direction: column; flex: 1; }
  .bcard__date, .bcard__more {
    font-family: var(--font-mono); font-size: var(--fs-label); font-weight: 500;
    letter-spacing: 0.08em; text-transform: uppercase;
  }
  .bcard__date { color: var(--text-dim); margin-bottom: 1rem; }
  .bcard__title { font-size: clamp(1.2rem, 1.6vw, 1.4rem); letter-spacing: -0.02em; line-height: 1.15; margin-bottom: 0.7rem; }
  .bcard__excerpt { font-size: var(--fs-sm); line-height: 1.55; color: var(--text-muted); margin-bottom: 1.75rem; }
  .bcard__more { margin-top: auto; color: var(--text); display: inline-flex; gap: 0.6rem; }
  .bcard__more span { transition: transform 0.25s var(--reveal-ease); }
  .bcard:hover .bcard__more { color: var(--accent); }
  .bcard:hover .bcard__more span { transform: translateX(4px); }
</style>
