---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import { jobs, applyEmail } from '../../data/jobs';
---
<BaseLayout
  title="Careers — Player One Space"
  description="Join Player One Space in Vancouver. We build onboard AI and water propulsion that let satellites protect themselves."
  path="/careers"
>
  <Hero
    eyebrow="Careers"
    title="Build satellites<br>that protect themselves."
    sub="A small team in Vancouver building onboard AI and a water thruster. Your work goes to the bench this year and to orbit after that."
  />

  <Section eyebrow="Open roles" title="Join the team.">
    <div class="jobs">
      {jobs.map((j) => (
        <a class="job reveal" href={j.external ?? `/careers/${j.slug}/`} {...(j.external ? { target: '_blank', rel: 'noopener' } : {})}>
          <div class="job__main">
            <span class="job__team display">{j.team}</span>
            <h3 class="job__title">{j.title}</h3>
            <p class="job__sum">{j.summary}</p>
          </div>
          <div class="job__meta">
            <span>{j.location}</span>
            <span>{j.type}</span>
            <span class="job__more display">{j.external ? 'View on Wellfound ↗' : 'View role →'}</span>
          </div>
        </a>
      ))}
    </div>
  </Section>

  <Section eyebrow="Why join" title="What you get." alt={true}>
    <div class="grid grid--3">
      <div class="why reveal"><h3>Real hardware</h3><p>You build units that go to the bench this year and to orbit after that. No paper studies.</p></div>
      <div class="why reveal"><h3>Ownership</h3><p>A small team. You own your part of the system from design to test.</p></div>
      <div class="why reveal"><h3>Early equity</h3><p>Salary plus meaningful equity. You join early and share in what we build.</p></div>
    </div>
    <p class="lead reveal" style="margin-top: 2.5rem;">Don't see your role? Send your CV and a short note to <a href={`mailto:${applyEmail}`}>{applyEmail}</a>.</p>
  </Section>
</BaseLayout>

<style>
  .jobs { display: flex; flex-direction: column; border-top: 1px solid var(--line-hi); }
  .job {
    display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 6.5fr) minmax(0, 2.5fr); gap: 0.7rem 2rem; align-items: start;
    border-bottom: 1px solid var(--line); padding: clamp(1.6rem, 3vw, 2.25rem) 0; color: inherit;
    transition: background 0.3s, padding 0.4s var(--reveal-ease);
  }
  .job:hover { background: var(--surface); padding-left: 1.25rem; padding-right: 1.25rem; }
  .job__main { display: contents; }
  .job__team { font-size: var(--fs-label); color: var(--accent); padding-top: 0.5rem; grid-column: 1; grid-row: 1 / span 2; }
  .job__title { font-size: clamp(1.5rem, 2.6vw, 2.25rem); letter-spacing: -0.035em; line-height: 1.02; grid-column: 2; grid-row: 1; }
  .job__sum { font-size: var(--fs-sm); max-width: 58ch; grid-column: 2; grid-row: 2; }
  .job__meta { grid-column: 3; grid-row: 1 / span 2; display: flex; flex-direction: column; gap: 0.3rem; text-align: right; font-size: var(--fs-sm); color: var(--text-muted); padding-top: 0.35rem; }
  .job__more { margin-top: 0.9rem; font-size: var(--fs-label); color: var(--text); }
  .job:hover .job__more { color: var(--accent); }
  .why { padding: 1.6rem 1.6rem 2rem; min-height: 13rem; display: flex; flex-direction: column; justify-content: flex-end; }
  .why h3 { font-size: clamp(1.25rem, 1.7vw, 1.5rem); letter-spacing: -0.02em; margin-bottom: 0.7rem; }
  .why p { font-size: var(--fs-sm); }
  @media (max-width: 860px) {
    .job { grid-template-columns: 1fr; gap: 0.75rem; }
    .job__title, .job__sum, .job__meta { grid-column: 1; grid-row: auto; margin-top: 0; }
    .job__meta { text-align: left; flex-direction: row; flex-wrap: wrap; gap: 0.3rem 1rem; }
    .job__more { margin-top: 0; width: 100%; }
    .job__team { padding-top: 0; }
  }
</style>
