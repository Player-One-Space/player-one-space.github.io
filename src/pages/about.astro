---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ModuleCard from '../components/ModuleCard.astro';
import TeamCard from '../components/TeamCard.astro';

const problems = [
  { tag: 'Blind', title: 'Satellites cannot see threats', body: 'Ground-based space domain awareness takes 30 minutes to 6+ hours to flag a close approach — long after an adversarial satellite is already alongside. No satellite carries onboard intelligence to detect and alert on its own.' },
  { tag: 'Immobile', title: 'Satellites cannot afford to move', body: '60% of CubeSats launch with zero propulsion, priced out of toxic, expensive options. A satellite that cannot manoeuvre is a sitting target — for proximity operations, debris, and deorbit mandates it cannot meet.' },
];

const team = [
  {
    photo: '/images/dima.jpg',
    name: 'Dima Anoshin',
    role: 'CEO & Founder',
    bio: 'Spacecraft hardware at Khrunichev (Proton/Angara) and LEO satellites at Amazon. 15+ years building data and AI platforms. PhD, Mechanical Engineering.',
  },
  {
    photo: '/images/jay.jpg',
    name: 'Jay Bowman',
    role: 'Chief Engineer, Propulsion',
    bio: 'Inventor of the water-electrolysis micro-arcjet thruster. 12 international patents across advanced hardware and power electronics. Owns thruster architecture and board-level electrical design.',
  },
  {
    photo: '/images/umut-k.jpg',
    name: 'Umut Kızılyamaç',
    role: 'Head of Space Systems Engineering',
    bio: 'Senior space systems engineer specializing in spacecraft architecture, ADCS, and electric propulsion. Seven spacecraft platforms and 21 satellite missions at Plan-S, working alongside Dr. Umut Yıldız. Led the end-to-end development of an electric propulsion system, from concept through testing and product realization.',
  },
  {
    photo: '/images/vladimir.jpg',
    name: 'Vladimir Valeyev',
    role: 'Head of AI and Computer Vision',
    bio: 'Computer vision and autonomous systems engineer. Satellite and SAR imagery analysis, object detection, tracking and pose estimation, few-shot and open-set recognition, and reinforcement learning for robotic control and collision avoidance. Deploys models to the edge with TensorRT, ONNX and OpenVINO, on a foundation of embedded C and FPGA development. Owns the onboard perception pipeline and the AI star tracker.',
  },
  {
    photo: '/images/sergey.jpg',
    name: 'Sergey Kruchinin',
    role: 'Head of Embedded Software',
    bio: '25+ years in embedded and safety-critical software. Develops DO-178C DAL B certified avionics software; previously founder and software architect for large-scale industrial robotics, delivering 10 fully automated systems across Canada and the USA. Real-time motion control, deterministic firmware, CAN and embedded networking, bootloaders and over-the-air update systems. Owns the propulsion controller — the layer that connects the autonomy engine to the thruster.',
  },
  {
    photo: '/images/anton.jpg',
    name: 'Anton Borisov',
    role: 'Head of Synthetic Environments',
    bio: 'Environments supervisor at Industrial Light & Magic; previously Digital Domain and DNEG. Architects Hollywood-grade Unreal Engine worlds and synthetic data generation pipelines for machine-vision training, grounded in aerospace systems engineering.',
  },
];

const advisors = [
  {
    photo: '/images/umut.jpg',
    name: 'Dr. Umut Yıldız',
    role: 'Technical Advisor',
    bio: 'NASA / JPL researcher and Caltech postdoc. Chief Scientific Officer at Plan-S, where he and Umut Kızılyamaç delivered 21 satellite missions together. PhD Astrophysics, Leiden University.',
  },
  {
    photo: '/images/cyrus.jpg',
    name: 'Dr. Cyrus Neary',
    role: 'Technical Advisor',
    bio: 'Assistant Professor at the University of British Columbia. His research develops theory and algorithms that enable scalable, generalizable, and compositional AI systems for autonomy, robotics, modelling, and control. Previously a postdoctoral researcher at Mila – the Québec AI Institute. PhD, UT Austin.',
  },
  {
    photo: '/images/manish.jpg',
    name: 'Dr. Manish Jugroot',
    role: 'Technical Advisor',
    bio: 'Professor of Mechanical and Aerospace Engineering at the Royal Military College of Canada and Director of the RAPPEL Lab for advanced propulsion and plasma exploration. His research spans ionized gases and plasmas, electric spacecraft propulsion, and nanosatellites. PhD, Université Paul Sabatier, Toulouse.',
  },
];

// Combined-experience logo strip. Drop official files at these paths to replace the placeholders.
const logos = [
  { name: 'Microsoft', src: '/images/logo-microsoft.svg' },
  { name: 'Amazon', src: '/images/logo-amazon.svg' },
  { name: 'NASA', src: '/images/logo-nasa.svg' },
  { name: 'UBC', src: '/images/logo-ubc.svg' },
  { name: 'Disney', src: '/images/logo-disney.svg' },
  { name: 'Unreal Engine', src: '/images/logo-unreal.svg' },
  { name: 'Royal Military College of Canada', src: '/images/logo-rmc.svg' },
];
---
<BaseLayout
  title="About — Player One Space"
  description="Player One Space is a space innovation company building IP-protected dual-use space technology. Led by veterans of Amazon, NASA/JPL, Khrunichev, and Plan-S."
  path="/about"
>
  <Hero
    eyebrow="About"
    title="The team that has built<br>every layer of the stack."
    sub="Player One Space is a space innovation company. We solve high-impact problems in the space economy, protect the solutions with IP, and bring them to market as products."
  />

  <Section eyebrow="The Problem" title="Satellites are blind and immobile.">
    <p class="lead reveal" style="margin-bottom: 2.5rem;">That is the defining vulnerability of the space age. Fix both and you have the first satellite that can detect a threat, classify it, and manoeuvre to safety — autonomously.</p>
    <div class="grid grid--2">
      {problems.map((p) => <ModuleCard tag={p.tag} title={p.title} body={p.body} />)}
    </div>
  </Section>

  <Section eyebrow="Approach" title="One company. Two products.<br>A growing portfolio." alt={true}>
    <p class="lead reveal">We do not bet on a single product. We identify unsolved problems in space, build proprietary solutions, and own the IP. Plasma and Buddy are the first two — each fundable on its own, and together the foundation of a self-defending satellite no competitor can match today.</p>
  </Section>

  <Section eyebrow="Leadership" title="Built by operators.">
    <div class="grid grid--3">
      {team.map((m) => <TeamCard photo={m.photo} name={m.name} role={m.role} bio={m.bio} />)}
    </div>
    <div class="advisors">
      <span class="bracket-label reveal">Advisors</span>
      <div class="grid grid--3" style="margin-top: 1.1rem;">
        {advisors.map((m) => <TeamCard photo={m.photo} name={m.name} role={m.role} bio={m.bio} />)}
      </div>
    </div>
    <div class="exp reveal">
      <span class="bracket-label">Combined Experience</span>
      <div class="exp__logos">
        {logos.map((l) => <img class="exp__logo" src={l.src} alt={l.name} height="30" loading="lazy" />)}
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .advisors { margin-top: 3.5rem; }
  .exp { margin-top: 3rem; }
  .exp__logos {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: 2.25rem 3rem; margin-top: 1.1rem;
  }
  /* Force any source logo to white on the dark canvas; muted, brighten on hover. */
  .exp__logo {
    height: 30px; width: auto; max-width: 150px; object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.55; transition: opacity 0.25s ease;
  }
  .exp__logo:hover { opacity: 1; }
</style>
