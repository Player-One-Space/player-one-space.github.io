---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ModuleCard from '../components/ModuleCard.astro';
import TeamCard from '../components/TeamCard.astro';

const problems = [
  { tag: 'Blind', title: 'Satellites cannot see threats', body: 'Ground-based space domain awareness takes 30 minutes to 6+ hours to flag a close approach — long after an adversarial satellite is already alongside. No satellite carries onboard intelligence to detect and alert on its own.' },
  { tag: 'Immobile', title: 'Satellites cannot afford to move', body: 'More than 80% of CubeSats launch with zero propulsion, priced out of toxic, expensive options. A satellite that cannot manoeuvre is a sitting target — for proximity operations, debris, and deorbit mandates it cannot meet.' },
];

const team = [
  {
    photo: '/images/dima.jpg',
    name: 'Dima',
    role: 'CEO & Founder',
    bio: 'Spacecraft hardware at Khrunichev (Proton/Angara). Built large-scale data platforms at Amazon Devices, the same organization that builds Project Kuiper. 15+ years building data and AI platforms. PhD, Mechanical Engineering.',
  },
  {
    photo: '/images/jay.jpg',
    name: 'Jay',
    role: 'CTO',
    bio: 'Inventor of the water-electrolysis micro-arcjet thruster. Holds 12 patents from earlier work in advanced hardware and power electronics. Owns the technical architecture across both products and leads the propulsion track.',
  },
  {
    photo: '/images/umut-k.jpg',
    name: 'Umut K.',
    role: 'Head of Space Systems Engineering',
    bio: 'Spacecraft architecture, ADCS and electric propulsion across seven platforms and 21 satellite missions at Plan-S, alongside Dr. Umut Yıldız. Took an electric propulsion system from concept to product.',
  },
  {
    photo: '/images/vladimir.jpg',
    name: 'Vladimir',
    role: 'Lead AI Engineer',
    bio: 'Computer vision and autonomous systems — satellite and SAR imagery, pose estimation, and reinforcement learning for collision avoidance. Builds models that run on constrained edge hardware. Works with our CEO on the onboard perception stack: model training, quantization and edge deployment.',
  },
  {
    photo: '/images/sergey.jpg',
    name: 'Sergey',
    role: 'Head of Embedded Software',
    bio: '25+ years in embedded and safety-critical software, including DO-178C certified avionics. Previously architected industrial robotics deployed across Canada and the USA. Owns the propulsion controller linking the autonomy engine to the thruster.',
  },
  {
    photo: '/images/anton.jpg',
    name: 'Anton',
    role: 'Head of Synthetic Environments',
    bio: 'Environments supervisor at Industrial Light & Magic; previously Digital Domain and DNEG. Architects Hollywood-grade Unreal Engine worlds and synthetic data generation pipelines for machine-vision training, grounded in aerospace systems engineering.',
  },
  {
    photo: '/images/ksenia.jpg',
    name: 'Ksenia',
    role: 'AI/ML Engineer',
    bio: 'Python and C/C++, computer vision and reinforcement learning. Works in Blender and Unreal Engine, and comes from a data analytics background. Supports the AI team on data pipelines, training runs and model evaluation.',
  },
];

const advisors = [
  {
    photo: '/images/umut.jpg',
    name: 'Dr. Umut Yıldız',
    role: 'Technical Advisor',
    bio: 'NASA / JPL researcher and Caltech postdoc. Chief Scientific Officer at Plan-S, where he and Umut Kızılyamaç delivered 21 satellite missions together. PhD Astrophysics, Leiden University.',
  },
  {
    photo: '/images/cyrus.jpg',
    name: 'Dr. Cyrus Neary',
    role: 'Technical Advisor',
    bio: 'Assistant Professor at the University of British Columbia, working on AI systems for autonomy, robotics and control. Previously a postdoctoral researcher at Mila. PhD, UT Austin.',
  },
  {
    photo: '/images/manish.jpg',
    name: 'Dr. Manish Jugroot',
    role: 'Technical Advisor',
    bio: 'Professor of Mechanical and Aerospace Engineering at the Royal Military College of Canada and Director of the RAPPEL Lab. Research spans plasmas, electric spacecraft propulsion and nanosatellites.',
  },
];

// Combined-experience logo strip. Drop official files at these paths to replace the placeholders.
const logos = [
  { name: 'Microsoft', src: '/images/logo-microsoft.svg' },
  { name: 'Amazon', src: '/images/logo-amazon.svg' },
  { name: 'NASA', src: '/images/logo-nasa.svg' },
  { name: 'UBC', src: '/images/logo-ubc.svg' },
  { name: 'Disney', src: '/images/logo-disney.svg' },
  { name: 'Unreal Engine', src: '/images/logo-unreal.svg' },
  { name: 'Royal Military College of Canada', src: '/images/logo-rmc.svg' },
];
---
<BaseLayout
  title="About — Player One Space"
  description="Player One Space builds autonomous defence for satellites: the brain that goes on any satellite, and the propulsion that moves it. Canadian-built, dual-use. Led by veterans of Amazon, NASA/JPL, Khrunichev, and Plan-S."
  path="/about"
>
  <Hero
    eyebrow="About"
    title="The team that has built<br>every layer of the stack."
    sub="Player One Space builds autonomous defence for satellites. We build the brain that goes on any satellite — and the propulsion that moves it. Detect, decide, manoeuvre."
  />

  <Section eyebrow="The Problem" title="Satellites are blind and immobile.">
    <p class="lead reveal" style="margin-bottom: 2.5rem;">That is the defining vulnerability of the space age. Fix both and you have a satellite that can detect a threat, classify it, and manoeuvre to safety — autonomously.</p>
    <div class="grid grid--2">
      {problems.map((p) => <ModuleCard tag={p.tag} title={p.title} body={p.body} />)}
    </div>
  </Section>

  <Section eyebrow="Approach" title="One company.<br>One system." alt={true}>
    <p class="lead reveal">Detect, decide, manoeuvre. P1S Buddy is the brain. P1S Plasma is the muscle. Each part also stands on its own, and Buddy works with third-party thrusters. Together they close the loop on one satellite. Our core models and decision thresholds are protected as trade secrets.</p>
  </Section>

  <Section eyebrow="Canada" title="A sovereign capability,<br>built in Canada.">
    <p class="lead reveal">Canada has named space domain awareness a priority for strategic autonomy. Its satellites watch the Arctic and the North Atlantic first. We are a Vancouver company — the principal AI work is done here, by the founding team, and the IP stays in Canada. Allied program offices get the capability from a supplier inside their own borders.</p>
  </Section>

  <Section eyebrow="Leadership" title="Built by engineers<br>who have shipped.">
    <div class="grid grid--3">
      {team.map((m) => <TeamCard photo={m.photo} name={m.name} role={m.role} bio={m.bio} />)}
    </div>
    <div class="advisors">
      <span class="bracket-label reveal">Advisors</span>
      <div class="grid grid--3" style="margin-top: 1.1rem;">
        {advisors.map((m) => <TeamCard photo={m.photo} name={m.name} role={m.role} bio={m.bio} />)}
      </div>
    </div>
    <div class="exp reveal">
      <span class="bracket-label">Combined Experience</span>
      <div class="exp__logos">
        {logos.map((l) => <img class="exp__logo" src={l.src} alt={l.name} height="30" loading="lazy" />)}
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .advisors { margin-top: 3.5rem; }
  .exp { margin-top: 3rem; }
  .exp__logos {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: 2.25rem 3rem; margin-top: 1.1rem;
  }
  /* Force any source logo to white on the dark canvas; muted, brighten on hover. */
  .exp__logo {
    height: 30px; width: auto; max-width: 150px; object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.55; transition: opacity 0.25s ease;
  }
  .exp__logo:hover { opacity: 1; }
</style>
