---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ModuleCard from '../components/ModuleCard.astro';
import StatRow from '../components/StatRow.astro';

const BROCHURE = '/player-one-space-brochure.pdf';
const PRESENTATION = '/player-one-space-company-presentation.pdf';

const buyWays = [
  { tag: 'Option 01', title: 'Integrated kit', body: 'P1S Buddy and P1S PELTAST-X together. One kit per satellite, one integration.' },
  { tag: 'Option 02', title: 'P1S Buddy', body: 'The AI unit on its own. Works with any thruster the satellite already carries.' },
  { tag: 'Option 03', title: 'P1S PELTAST-X', body: 'The water thruster on its own. Gentle moves or a fast burst.' },
];

const buddyModules = [
  { tag: 'M01 — Safe Manoeuvre Engine', title: 'Autonomous collision avoidance', body: 'Takes a conjunction warning, then plans, checks and runs the avoidance manoeuvre onboard. No person in the loop. Every command passes a safety shield before it reaches the thruster.' },
  { tag: 'M02 — VisNav', title: 'Sees what is around it', body: 'Visible, event-based and thermal cameras track nearby objects in sunlight and in eclipse: range, pose and velocity. The AI model is designed to run under 5 W.' },
  { tag: 'M03 — Pattern-of-Life + Alert', title: 'Spots threats, sends a short alert', body: 'An orbital-mechanics filter flags an object that manoeuvres to match your orbit. It sends a small alert: class, range, vector, confidence. Kilobytes, not video.' },
];
const buddyTam = [
  { value: '$2.8B', label: 'Space situational awareness market by 2030' },
  { value: '~1,200', label: 'Allied defence satellites: our first customers' },
];

const plasmaStages = [
  { tag: 'P1 — Electrolysis', title: 'Water to H₂ and O₂', body: 'The thruster launches with 250 mL of plain water, unpressurized. In orbit it splits the water into hydrogen and oxygen. No toxic propellant.' },
  { tag: 'P2 — Hybrid thrust', title: 'Cold gas plus pulsed combustion', body: 'H₂, O₂ and mixed cold gas handle fine control and routine work. A pulsed combustion mode gives short, strong pulses when the satellite must move. ~8–40 mN cold gas · 1–5 N pulsed.' },
  { tag: 'P3 — 2U module', title: 'Sized for small satellites', body: 'The whole unit fits a 2U bay: 1.8 kg dry, 2.0 kg with water. It works with satellites of any mass.' },
];
const plasmaTam = [
  { value: '16,900', label: 'Small satellites launching 2026–2035' },
  { value: '80%+', label: 'of CubeSats launch with no propulsion today' },
];

const specs = [
  ['Role', 'Sees, tracks and reports objects around the satellite', 'Avoidance, station keeping and deorbit'],
  ['Size', '232 × 191 × 107 mm', '2U, 100 × 100 × 227 mm'],
  ['Mass', '2.4 kg', '1.8 kg dry, 2.0 kg with water'],
  ['Power', '25 W orbit average, 31 W peak', '20 W while making gas, 3 W standby'],
  ['Supply', '28 V DC', '28 V DC'],
  ['Data', 'Gigabit Ethernet, CSP over CAN, RS-422, PPS', 'CSP over CAN, RS-422'],
  ['Modes', 'Survey, encounter recording, eclipse watch', 'Cold gas (H₂, O₂ or mixed), pulsed combustion'],
  ['Performance', '10 cm object in sunlight at 83 km; 1 m object in eclipse at 24 km; 88% of 10 cm crossings seen', '~8–40 mN cold gas, 1–5 N pulsed; 470 N·s total impulse; 24 m/s for a 20 kg satellite'],
  ['Response', 'Detection report every 0.1 s', 'Valves open in 2–5 ms'],
  ['Onboard store', '1 TB of encounter recordings', '250 mL of water, unpressurized at launch'],
];
---
<BaseLayout
  title="Products — Player One Space"
  description="P1S Buddy, the onboard AI unit, and P1S PELTAST-X, a water-fuelled hybrid thruster. Detect, decide, manoeuvre. No person in the loop."
  path="/products"
>
  <Hero
    eyebrow="Products"
    title="Detect. Decide.<br>Manoeuvre."
    sub="Two units, one system. P1S Buddy sees the threat and decides. P1S PELTAST-X moves the satellite out of the way. No person in the loop."
  />

  <Section eyebrow="How it works" title="The self-defending satellite.">
    <div class="flow reveal">
      <span class="flow__step display">Buddy sees a threat</span>
      <span class="flow__arrow">→</span>
      <span class="flow__step display">Classifies it</span>
      <span class="flow__arrow">→</span>
      <span class="flow__step display">Plans the move</span>
      <span class="flow__arrow">→</span>
      <span class="flow__step flow__step--hi display">PELTAST-X fires, satellite moves away</span>
    </div>
    <p class="lead reveal flow-lead">No ground loop. The AI never drives the thruster directly. It asks for a manoeuvre, and a validated propulsion controller runs it inside a safe envelope. The same interface works with our thruster or a third-party thruster the satellite already carries.</p>
    <div class="grid grid--3">
      {buyWays.map((c) => <ModuleCard tag={c.tag} title={c.title} body={c.body} />)}
    </div>
  </Section>

  <Section eyebrow="Onboard AI" title="P1S Buddy" id="buddy" alt={true}>
    <div class="prod reveal">
      <figure class="prod__img plate"><img src="/images/buddy-front.jpg" alt="P1S Buddy camera unit, front view" loading="lazy" /><figcaption>Fig. 01 — P1S Buddy</figcaption></figure>
      <div class="prod__txt">
        <span class="chip">TRL 4 · TRL 5–6 by end of 2026</span>
        <p class="lead">The onboard AI unit that sees what is around the satellite and decides what to do. When a conjunction warning arrives or an object comes close, Buddy plans the avoidance manoeuvre onboard. No ground loop, no waiting on a flight-dynamics team.</p>
        <p class="lead">New models go up over the air, so Buddy gets better after launch. It flies in December 2027.</p>
      </div>
    </div>
    <div class="grid grid--3 sub-grid">
      {buddyModules.map((m) => <ModuleCard tag={m.tag} title={m.title} body={m.body} />)}
    </div>
    <StatRow stats={buddyTam} />
  </Section>

  <Section eyebrow="Propulsion" title="P1S PELTAST-X" id="plasma">
    <div class="prod prod--flip reveal">
      <figure class="prod__img plate"><img src="/images/peltast-x.jpg" alt="P1S PELTAST-X 2U thruster module" loading="lazy" /><figcaption>Fig. 02 — P1S PELTAST-X</figcaption></figure>
      <div class="prod__txt">
        <span class="chip">TRL 3 · TRL 4–5 by end of 2026</span>
        <p class="lead">A water-fuelled hybrid thruster. Precise cold-gas modes do routine work. A pulsed combustion mode gives short, strong pulses for fast avoidance. Moderate thrust: ~8–40 mN cold gas · 1–5 N pulsed.</p>
        <p class="lead">It covers station keeping, collision avoidance, orbit changes and controlled deorbit, on a propellant that is safe to launch. It flies in mid-2028.</p>
      </div>
    </div>
    <div class="grid grid--3 sub-grid">
      {plasmaStages.map((m) => <ModuleCard tag={m.tag} title={m.title} body={m.body} />)}
    </div>
    <div class="reveal tbl">
      <table class="dtable">
        <thead><tr><th>Propellant</th><th>Launch classification</th></tr></thead>
        <tbody>
          <tr><td>Hydrazine</td><td>HAZMAT Class 6.1, toxic</td></tr>
          <tr><td>Xenon</td><td>High-pressure vessel</td></tr>
          <tr><td>Iodine</td><td>Corrosive, special manifesting</td></tr>
          <tr class="row-hi"><td>Water</td><td>Non-hazardous, standard cargo</td></tr>
        </tbody>
      </table>
    </div>
    <StatRow stats={plasmaTam} />
  </Section>

  <Section eyebrow="Specifications" title="Two units.<br>One system." id="specs" alt={true}>
    <p class="lead reveal offset">Each unit works on its own or as one subsystem. Both run on 28 V and talk to the host computer over CAN or RS-422.</p>
    <div class="spec-wrap reveal">
      <table class="dtable spec">
        <thead><tr><th></th><th>P1S Buddy</th><th>P1S PELTAST-X</th></tr></thead>
        <tbody>
          {specs.map((r) => <tr><td>{r[0]}</td><td>{r[1]}</td><td>{r[2]}</td></tr>)}
        </tbody>
      </table>
    </div>
    <p class="fineprint reveal">Modelled and design values. Bench tests confirm them through 2026–2027.</p>
    <a href={BROCHURE} target="_blank" rel="noopener" class="btn btn--ghost reveal" style="margin-top: 1.5rem;">Download brochure (PDF)</a>
  </Section>

  <Section eyebrow="Roadmap" title="Up to TRL 6 by end of 2026.<br>Flight proven by 2028." id="roadmap">
    <div class="reveal" style="overflow-x:auto;">
      <table class="dtable">
        <thead><tr><th>Product</th><th>Today</th><th>End of 2026</th><th>In orbit</th><th>Flight proven</th></tr></thead>
        <tbody>
          <tr><td>P1S Buddy · AI unit</td><td>TRL 4</td><td>TRL 5–6</td><td>December 2027</td><td>TRL 9 · 2027</td></tr>
          <tr><td>P1S PELTAST-X · Propulsion</td><td>TRL 3</td><td>TRL 4–5</td><td>Mid-2028</td><td>TRL 9 · 2028</td></tr>
          <tr class="row-hi"><td>Buddy + PELTAST-X · Integrated system</td><td>TRL 3</td><td>TRL 4–5</td><td>Mid-2028</td><td>TRL 9 · 2028</td></tr>
        </tbody>
      </table>
    </div>
    <p class="lead reveal" style="margin-top: 2.5rem;">Every flying unit comes with a yearly AI licence. Software updates are sent up from the ground.</p>
  </Section>

  <Section alt={true}>
    <div class="cta-block reveal">
      <span class="bracket-label" style="margin-bottom: 0;">Next Step</span>
      <h2 class="cta-block__title">Want the full picture?</h2>
      <p class="lead">Add P1S Buddy and P1S PELTAST-X to your next mission. Sales and documentation: <a href="mailto:dennis@playeronespace.com">dennis@playeronespace.com</a></p>
      <div class="cta-block__btns">
        <a href="mailto:dennis@playeronespace.com" class="btn btn--primary">Talk to Sales</a>
        <a href={PRESENTATION} target="_blank" rel="noopener" class="btn btn--ghost">Company presentation (PDF)</a>
        <a href={BROCHURE} target="_blank" rel="noopener" class="btn btn--ghost">Brochure (PDF)</a>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .prod { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); border: 1px solid var(--line); margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .prod--flip { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  .prod--flip .prod__img { order: 2; border-right: none; border-left: 1px solid var(--line); }
  .prod__img { border-right: 1px solid var(--line); min-height: clamp(18rem, 36vw, 30rem); }
  .prod__img img { position: absolute; inset: 0; }
  .prod__txt { padding: clamp(1.6rem, 3vw, 2.75rem); display: flex; flex-direction: column; justify-content: center; gap: 1.25rem; }
  .prod__txt .chip { align-self: flex-start; margin-bottom: 0.5rem; }
  .sub-grid { margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .tbl { overflow-x: auto; margin-bottom: clamp(2.5rem, 5vw, 4rem); }

  .flow { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--line); }
  .flow__step {
    position: relative; padding: 1.4rem 1.5rem 1.6rem; border-right: 1px solid var(--line);
    font-family: var(--font-heading); font-size: clamp(1.15rem, 1.7vw, 1.45rem); font-weight: 500;
    letter-spacing: -0.02em; line-height: 1.15; text-transform: none; color: var(--text);
    display: flex; flex-direction: column; gap: 2.5rem; counter-increment: flow;
  }
  .flow { counter-reset: flow; }
  .flow__step::before {
    content: counter(flow, decimal-leading-zero); font-family: var(--font-mono); font-size: var(--fs-label);
    letter-spacing: 0.08em; color: var(--text-dim);
  }
  .flow__step:last-child { border-right: none; }
  .flow__step--hi { background: var(--accent); color: var(--on-accent); }
  .flow__step--hi::before { color: var(--on-accent); }
  .flow__arrow { display: none; }
  .flow-lead { margin: clamp(2rem, 4vw, 3rem) 0; }

  .spec-wrap { overflow-x: auto; }
  .spec { min-width: 620px; }
  .spec thead th:not(:first-child) { color: var(--text); font-family: var(--font-heading); font-size: 1.15rem; letter-spacing: -0.02em; text-transform: none; }
  .spec td:first-child { width: 16%; font-family: var(--font-mono); font-size: var(--fs-label); letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-dim); font-weight: 500; padding-top: 1.25rem; }
  .spec td { font-variant-numeric: tabular-nums; }

  @media (max-width: 900px) {
    .prod, .prod--flip { grid-template-columns: 1fr; }
    .prod__img, .prod--flip .prod__img { order: 0; border: none; border-bottom: 1px solid var(--line); min-height: 0; aspect-ratio: 14 / 10; }
    .flow { grid-template-columns: 1fr 1fr; }
    .flow__step:nth-child(3) { border-right: none; }
    .flow__step:nth-child(-n + 3) { border-bottom: 1px solid var(--line); }
    .flow__step { gap: 1.5rem; }
  }
</style>
