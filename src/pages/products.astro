---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ModuleCard from '../components/ModuleCard.astro';
import StatRow from '../components/StatRow.astro';

const plasmaCaps = [
  { title: 'Non-toxic & launch-safe', body: 'Water propellant ships as standard cargo. No HAZMAT, no high-pressure vessel, no special handling — compatible even near crewed vehicles.' },
  { title: 'Sized for small spacecraft', body: 'Built for the platforms where thrust-to-mass matters most. Larger spacecraft are served by scaling the propellant load — the physics is unchanged, the tank grows.' },
  { title: 'Refuelable anywhere', body: 'Water ice exists on the Moon, Mars, and asteroids. The only propulsion whose supply chain extends across the solar system.' },
];
const plasmaTam = [
  { value: '$850M+', label: 'Satellite electric propulsion market by 2032' },
  { value: '80%+', label: 'of CubeSats launch with no propulsion today' },
];

const buddyCaps = [
  { title: 'Hardware-agnostic', body: 'Runs on any satellite with a COTS camera and an edge compute board. No custom hardware, no vendor lock-in.' },
  { title: 'Updatable over the air', body: 'New models deploy to orbit like software. The capability improves long after the satellite has launched.' },
  { title: 'Propulsion-agnostic', body: 'Commands our own micro-arcjet or a third-party thruster through the same safety-bounded interface — the AI requests a maneuver; a validated controller executes it.' },
];
const buddyTam = [
  { value: '$2.3B+', label: 'Space domain awareness market by 2030' },
  { value: '8,000+', label: 'active satellites — every one a potential customer' },
];
---
<BaseLayout
  title="Products — Player One Space"
  description="Buddy: the onboard AI engine that commands any propulsion. Plasma: water-electrolysis propulsion built for it. Two IP-protected products from Player One Space."
  path="/products"
>
  <Hero
    eyebrow="Products"
    title="Two products.<br>One integrated stack."
    sub="The AI engine leads; the thruster is built for it — and the same AI commands third-party propulsion too. Together, the first fully autonomous self-defending satellite."
  />

  <Section eyebrow="Flagship — Onboard Autonomy" title="Buddy" id="buddy">
    <p class="lead reveal" style="margin-bottom: 2.5rem;">The onboard, unified AI engine that makes autonomous decisions and delivers real-time intelligence from orbit. Its first job is acting: when a conjunction warning arrives, Buddy plans and executes the avoidance maneuver onboard, through a safety-bounded interface — no ground loop, no waiting on a flight-dynamics team. Its second job is seeing: tracking nearby objects of known geometry for proximity awareness, inspection, and threat characterization — with debris tracking as a complementary capability, not the promise.</p>
    <div class="grid grid--3" style="margin-bottom: 3rem;">
      {buddyCaps.map((c) => <ModuleCard title={c.title} body={c.body} />)}
    </div>
    <StatRow stats={buddyTam} />
  </Section>

  <Section eyebrow="Propulsion — Built for Buddy" title="Plasma" id="plasma" alt={true}>
    <p class="lead reveal" style="margin-bottom: 2.5rem;">A water-electrolysis pulsed micro-arcjet — the first propulsion system designed for Buddy's command interface. The legs that let a small satellite manoeuvre: station-keeping, collision avoidance, orbit changes, and controlled deorbit, on a propellant that is safe to launch.</p>
    <div class="grid grid--3" style="margin-bottom: 3rem;">
      {plasmaCaps.map((c) => <ModuleCard title={c.title} body={c.body} />)}
    </div>
    <StatRow stats={plasmaTam} />
  </Section>

  <Section>
    <div class="cta reveal">
      <h2 class="display cta__title">Want the full picture?</h2>
      <p class="lead">We work with investors, government program offices, and satellite bus partners.</p>
      <a href="/contact" class="btn btn--primary">Get in Touch</a>
    </div>
  </Section>
</BaseLayout>

<style>
  .cta { text-align: center; max-width: 60ch; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 1.25rem; }
  .cta__title { font-size: clamp(1.8rem, 4vw, 3rem); }
</style>
