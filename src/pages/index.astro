---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import StatRow from '../components/StatRow.astro';
import ProductCard from '../components/ProductCard.astro';
import ModuleCard from '../components/ModuleCard.astro';
import BlogCard from '../components/BlogCard.astro';

const BLOG_URL = 'https://blog.playeronespace.com';

// Pull the latest posts from the Substack RSS feed at build time.
function decode(s = '') {
  return s
    .replace(/<!\[CDATA\[([\s\S]*?)\]\]>/g, '$1')
    .replace(/<[^>]+>/g, '')
    .replace(/&#8217;|&#8216;/g, '’')
    .replace(/&#8220;|&#8221;/g, '"')
    .replace(/&#8212;/g, '—')
    .replace(/&#8211;/g, '–')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;|&apos;/g, "'")
    .trim();
}

async function getPosts() {
  try {
    const res = await fetch(`${BLOG_URL}/feed`);
    if (!res.ok) return [];
    const xml = await res.text();
    const items = xml.split('<item>').slice(1).map((chunk) => {
      const item = chunk.split('</item>')[0];
      const pick = (tag: string) => decode((item.match(new RegExp(`<${tag}>([\\s\\S]*?)</${tag}>`)) || [])[1] || '');
      const img = (item.match(/<enclosure[^>]*url="([^"]+)"/) || [])[1] || '';
      const pub = pick('pubDate');
      const date = pub
        ? new Date(pub).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
        : '';
      return { title: pick('title'), href: pick('link'), excerpt: pick('description'), image: img, date };
    });
    return items.slice(0, 3);
  } catch {
    return [];
  }
}

const posts = await getPosts();

const tam = [
  { value: '$600B+', label: 'Commercial space market by 2040' },
  { value: '$30B+', label: 'US defense space budget, per year' },
  { value: '$850M+', label: 'Satellite electric propulsion by 2032' },
  { value: '$2.3B+', label: 'Space domain awareness by 2030' },
];

const whyNow = [
  { tag: 'Force 01', title: 'Edge AI is flight-ready', body: 'Radiation-tolerant edge compute now runs live AI on orbit. The hardware risk is retired — autonomy is a software problem now.' },
  { tag: 'Force 02', title: 'Propulsion is breaking', body: 'Xenon demand outpaces supply and hydrazine is being phased out. Operators need a safe, scalable alternative. Water is it.' },
  { tag: 'Force 03', title: 'Orbit is contested', body: 'Adversarial proximity operations are rising and most satellites cannot see or move. The window to solve both is open now.' },
];
---
<BaseLayout
  title="Player One Space — Autonomous Defence For Satellites"
  description="Player One Space builds the brain that goes on any satellite — onboard AI that spots a non-cooperative approach, and propulsion that manoeuvres away. Decided in orbit, in seconds. Two IP-protected products: P1S Buddy and P1S Plasma."
  path="/"
>
  <Hero
    variant="full"
    eyebrow="A Space Innovation Company"
    title="Autonomous<br>Defence For<br>Satellites"
    sub="We build the brain that goes on any satellite — onboard AI that spots a non-cooperative approach, and propulsion that manoeuvres away. Decided in orbit, in seconds."
    video="/videos/earth-hero.mp4"
    poster="/images/earth-hero-poster.jpg"
  />

  <Section eyebrow="Two Products" title="The brain leads.<br>The legs follow.">
    <div class="grid grid--2">
      <ProductCard
        index="01"
        kicker="Flagship — Onboard Autonomy"
        name="Buddy"
        tagline="Onboard AI Engine"
        body="The onboard AI engine that makes autonomous decisions and delivers real-time intelligence from orbit — no ground loop. It commands propulsion through a safety-bounded interface: our own thruster, or any third-party thruster a satellite already carries."
        href="/products#buddy"
      />
      <ProductCard
        index="02"
        kicker="Propulsion — Built for Buddy"
        name="Plasma"
        tagline="Propulsion Engine"
        body="A water-electrolysis pulsed micro-arcjet — the first thruster designed for Buddy's command interface. Non-toxic, launch-safe, and ten times the thrust of electric thrusters in the same 1U volume."
        href="/products#plasma"
      />
    </div>
  </Section>

  <Section eyebrow="Market" title="A massive market.<br>Two uncrowded niches." alt={true}>
    <StatRow stats={tam} />
  </Section>

  <Section eyebrow="Why Now" title="The window is open in 2026.">
    <div class="grid grid--3">
      {whyNow.map((w) => <ModuleCard tag={w.tag} title={w.title} body={w.body} />)}
    </div>
  </Section>

  <Section eyebrow="From the Blog" title="Notes from the edge of space." alt={true}>
    {posts.length > 0 && (
      <div class="grid grid--3 blog-grid">
        {posts.map((p) => (
          <BlogCard href={p.href} title={p.title} excerpt={p.excerpt} date={p.date} image={p.image} />
        ))}
      </div>
    )}
    <div class="blog-actions reveal">
      <a href="https://blog.playeronespace.com/" target="_blank" rel="noopener" class="btn btn--ghost">Read the Blog</a>
      <a href="https://blog.playeronespace.com/subscribe" target="_blank" rel="noopener" class="btn btn--primary">Subscribe</a>
    </div>
  </Section>

  <Section>
    <div class="cta reveal">
      <h2 class="display cta__title">Building what comes after launch.</h2>
      <p class="lead">Detect. Classify. Evade — autonomously. The self-defending satellite.</p>
      <a href="/contact" class="btn btn--primary">Get in Touch</a>
    </div>
  </Section>
</BaseLayout>

<style>
  .cta { text-align: center; max-width: 60ch; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 1.25rem; }
  .cta__title { font-size: clamp(1.8rem, 4vw, 3rem); }
  .blog-grid { margin-bottom: 2.5rem; }
  .blog-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
</style>
