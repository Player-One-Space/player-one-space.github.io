---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import StatRow from '../components/StatRow.astro';
import ProductCard from '../components/ProductCard.astro';
import ModuleCard from '../components/ModuleCard.astro';
import BlogCard from '../components/BlogCard.astro';

const BLOG_URL = 'https://blog.playeronespace.com';

// Pull the latest posts from the Substack RSS feed at build time.
function decode(s = '') {
  return s
    .replace(/<!\[CDATA\[([\s\S]*?)\]\]>/g, '$1')
    .replace(/<[^>]+>/g, '')
    .replace(/&#8217;|&#8216;/g, '’')
    .replace(/&#8220;|&#8221;/g, '"')
    .replace(/&#8212;/g, '—')
    .replace(/&#8211;/g, '–')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;|&apos;/g, "'")
    .trim();
}

async function getPosts() {
  try {
    const res = await fetch(`${BLOG_URL}/feed`);
    if (!res.ok) return [];
    const xml = await res.text();
    const items = xml.split('<item>').slice(1).map((chunk) => {
      const item = chunk.split('</item>')[0];
      const pick = (tag: string) => decode((item.match(new RegExp(`<${tag}>([\\s\\S]*?)</${tag}>`)) || [])[1] || '');
      const img = (item.match(/<enclosure[^>]*url="([^"]+)"/) || [])[1] || '';
      const pub = pick('pubDate');
      const date = pub
        ? new Date(pub).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
        : '';
      return { title: pick('title'), href: pick('link'), excerpt: pick('description'), image: img, date };
    });
    return items.slice(0, 3);
  } catch {
    return [];
  }
}

const posts = await getPosts();

const problem = [
  { tag: '01 — Crowded', title: '16,900 more small satellites by 2035', body: 'Most of them have no way to move. Orbit gets busier every launch.' },
  { tag: '02 — Slow', title: 'The ground reacts in hours', body: 'Warnings go to people on the ground, who reach the satellite a few times a day. A close approach takes seconds.' },
  { tag: '03 — Exposed', title: 'Everyone else waits', body: 'Starlink dodges on its own, 300,000 times last year. Defence satellites are now targets. Most other satellites wait for the ground.' },
];

const tam = [
  { value: '$40B', label: 'US Space Force budget for 2026. Golden Dome names self-defending satellites as a goal.' },
  { value: '$2.8B', label: 'Space situational awareness market by 2030, up from $1.7B in 2025' },
  { value: '16,900', label: 'Small satellites launching 2026–2035' },
  { value: '~7,400', label: 'Of them fit the brain plus thruster' },
];

const whyNow = [
  { tag: 'Threats are real', title: 'Orbit is contested', body: 'Adversary satellites already park next to Western satellites without warning.' },
  { tag: 'The chips are ready', title: 'AI fits on a small satellite', body: 'Edge compute now runs live AI inside a small satellite, at low power.' },
  { tag: 'Buyers pay today', title: 'Defence money is moving', body: 'Lonestar paid up to $6M for satellite defence. France bought a defence satellite from a start-up.' },
  { tag: 'New rules', title: 'Five years to come down', body: 'Every satellite must leave orbit within 5 years of end of life. That takes a way to move.' },
];

const useDefence = [
  { tag: 'National security', title: 'Move away from threats', body: 'National security satellites spot a hostile approach and move away on their own.' },
  { tag: 'Tactical operations', title: 'Act when the link is jammed', body: 'The satellite keeps manoeuvring when the link to the ground is jammed or down.' },
  { tag: 'Defence command', title: 'Fast onboard alerts', body: 'Threat detection runs onboard. A small alert reaches the ground in seconds, not a video download.' },
];
const useCommercial = [
  { tag: 'Large constellations', title: 'Automatic collision avoidance', body: 'Avoid collisions and hold the orbit slot with no person in the loop.' },
  { tag: 'High-orbit operators', title: 'Protect expensive satellites', body: 'Watch for close approaches and react before they become a problem.' },
  { tag: 'Insurers', title: 'Lower risk, clean exit', body: 'A satellite that can move is a lower risk, and it can deorbit within the 5-year rule.' },
];
---
<BaseLayout
  title="Player One Space — Autonomous Defence For Satellites"
  description="Player One Space builds autonomous defence for satellites. Onboard AI that detects, decides and manoeuvres, with no person in the loop. P1S Buddy is the brain. P1S PELTAST-X is the legs."
  path="/"
>
  <Hero
    variant="full"
    eyebrow="Onboard AI + Propulsion"
    title="Autonomous<br>Defence For<br>Satellites"
    sub="Onboard AI that detects, decides and manoeuvres. No person in the loop. P1S Buddy is the brain. P1S PELTAST-X is the legs."
    video="/videos/earth-hero.mp4"
    poster="/images/earth-hero-poster.jpg"
  />

  <Section eyebrow="The Problem" title="Space is getting crowded.<br>Satellites cannot protect themselves.">
    <div class="grid grid--3">
      {problem.map((w) => <ModuleCard tag={w.tag} title={w.title} body={w.body} />)}
    </div>
  </Section>

  <Section eyebrow="One Kit. Two Products." title="The brain decides.<br>The legs move." alt={true}>
    <p class="lead reveal" style="margin-bottom: 2.5rem;">Reaction drops from hours to seconds. It works even when the link to the ground is jammed.</p>
    <div class="grid grid--2">
      <ProductCard
        index="01"
        kicker="Flagship — Onboard Autonomy"
        name="P1S Buddy"
        tagline="Onboard AI Engine"
        trl="TRL 4 · TRL 5 by April 2027"
        body="The onboard AI engine that makes autonomous decisions and delivers real-time intelligence from orbit — no ground loop. It commands propulsion through a safety-bounded interface: our own thruster, or any third-party thruster a satellite already carries."
        href="/products#buddy"
      />
      <ProductCard
        index="02"
        kicker="Propulsion — Built for Buddy"
        name="P1S PELTAST-X"
        tagline="Propulsion Engine"
        trl="TRL 3 · TRL 4 by March 2027"
        body="A water-fuelled hybrid thruster: precise cold-gas modes for routine work and a pulsed combustion mode for short, strong manoeuvres. Launches with 250 mL of plain water, unpressurized. Built for Buddy's command interface."
        href="/products#plasma"
      />
    </div>
  </Section>

  <Section eyebrow="Use Cases" title="One kit for defence<br>and commercial.">
    <h3 class="uc__head display reveal">Defence &amp; government</h3>
    <div class="grid grid--3" style="margin-bottom: 2.5rem;">
      {useDefence.map((u) => <ModuleCard tag={u.tag} title={u.title} body={u.body} />)}
    </div>
    <h3 class="uc__head display reveal">Commercial</h3>
    <div class="grid grid--3">
      {useCommercial.map((u) => <ModuleCard tag={u.tag} title={u.title} body={u.body} />)}
    </div>
  </Section>

  <Section eyebrow="Market" title="Dual use.<br>A large, open market." alt={true}>
    <StatRow stats={tam} />
    <p class="src reveal">Sources: US Space Force FY2026 request · SSA market research 2025–2030 · Novaspace 2026. The ~7,400 share is our estimate.</p>
  </Section>

  <Section eyebrow="Why Now" title="The window is open now.">
    <p class="lead reveal" style="margin-bottom: 2.5rem;">Within three years, the number of satellites in orbit will more than double. Space is becoming contested, and no ground team can watch that many satellites or react in time. Satellites will need to defend themselves.</p>
    <div class="grid grid--4">
      {whyNow.map((w) => <ModuleCard tag={w.tag} title={w.title} body={w.body} />)}
    </div>
  </Section>

  <Section eyebrow="From the Blog" title="Notes from the edge of space." alt={true}>
    {posts.length > 0 && (
      <div class="grid grid--3 blog-grid">
        {posts.map((p) => (
          <BlogCard href={p.href} title={p.title} excerpt={p.excerpt} date={p.date} image={p.image} />
        ))}
      </div>
    )}
    <div class="blog-actions reveal">
      <a href="https://blog.playeronespace.com/" target="_blank" rel="noopener" class="btn btn--ghost">Read the Blog</a>
      <a href="https://blog.playeronespace.com/subscribe" target="_blank" rel="noopener" class="btn btn--primary">Subscribe</a>
    </div>
  </Section>

  <Section>
    <div class="cta reveal">
      <h2 class="display cta__title">Building what comes after launch.</h2>
      <p class="lead">Detect. Decide. Manoeuvre. The self-defending satellite.</p>
      <a href="/contact" class="btn btn--primary">Get in Touch</a>
    </div>
  </Section>
</BaseLayout>

<style>
  .cta { text-align: center; max-width: 60ch; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 1.25rem; }
  .cta__title { font-size: clamp(1.8rem, 4vw, 3rem); }
  .uc__head { font-size: var(--fs-label); letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 1.1rem; }
  .src { margin-top: 2rem; font-size: var(--fs-label); color: var(--text-dim); }
  .blog-grid { margin-bottom: 2.5rem; }
  .blog-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
</style>
