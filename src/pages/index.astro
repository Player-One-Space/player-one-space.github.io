---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import StatRow from '../components/StatRow.astro';
import ProductCard from '../components/ProductCard.astro';
import ModuleCard from '../components/ModuleCard.astro';
import BlogCard from '../components/BlogCard.astro';
import Sequence from '../components/Sequence.astro';

const BLOG_URL = 'https://blog.playeronespace.com';

// Pull the latest posts from the Substack RSS feed at build time.
function decode(s = '') {
  return s
    .replace(/<!\[CDATA\[([\s\S]*?)\]\]>/g, '$1')
    .replace(/<[^>]+>/g, '')
    .replace(/&#8217;|&#8216;/g, '’')
    .replace(/&#8220;|&#8221;/g, '"')
    .replace(/&#8212;/g, '—')
    .replace(/&#8211;/g, '–')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;|&apos;/g, "'")
    .trim();
}

async function getPosts() {
  try {
    const res = await fetch(`${BLOG_URL}/feed`);
    if (!res.ok) return [];
    const xml = await res.text();
    const items = xml.split('<item>').slice(1).map((chunk) => {
      const item = chunk.split('</item>')[0];
      const pick = (tag: string) => decode((item.match(new RegExp(`<${tag}>([\\s\\S]*?)</${tag}>`)) || [])[1] || '');
      const img = (item.match(/<enclosure[^>]*url="([^"]+)"/) || [])[1] || '';
      const pub = pick('pubDate');
      const date = pub
        ? new Date(pub).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
        : '';
      return { title: pick('title'), href: pick('link'), excerpt: pick('description'), image: img, date };
    });
    return items.slice(0, 3);
  } catch {
    return [];
  }
}

const posts = await getPosts();

const problem = [
  { tag: '01 — Crowded', title: '16,900 more small satellites by 2035', body: 'Most of them have no way to move. Orbit gets busier every launch.' },
  { tag: '02 — Slow', title: 'The ground reacts in hours', body: 'Warnings go to people on the ground, who reach the satellite a few times a day. A close approach takes seconds.' },
  { tag: '03 — Exposed', title: 'Everyone else waits', body: 'Starlink dodges on its own, 300,000 times last year. Defence satellites are now targets. Most other satellites wait for the ground.' },
];

const tam = [
  { value: '$40B', label: 'US Space Force budget for 2026. Golden Dome names self-defending satellites as a goal.' },
  { value: '$2.8B', label: 'Space situational awareness market by 2030, up from $1.7B in 2025' },
  { value: '16,900', label: 'Small satellites launching 2026–2035' },
  { value: '~7,400', label: 'Of them fit the brain plus thruster' },
];

const whyNow = [
  { tag: 'Threats are real', title: 'Orbit is contested', body: 'Adversary satellites already park next to Western satellites without warning.' },
  { tag: 'The chips are ready', title: 'AI fits on a small satellite', body: 'Edge compute now runs live AI inside a small satellite, at low power.' },
  { tag: 'Buyers pay today', title: 'Defence money is moving', body: 'Lonestar paid up to $6M for satellite defence. France bought a defence satellite from a start-up.' },
  { tag: 'New rules', title: 'Five years to come down', body: 'Every satellite must leave orbit within 5 years of end of life. That takes a way to move.' },
];

const useDefence = [
  { tag: 'National security', title: 'Move away from threats', body: 'National security satellites spot a hostile approach and move away on their own.' },
  { tag: 'Tactical operations', title: 'Act when the link is jammed', body: 'The satellite keeps manoeuvring when the link to the ground is jammed or down.' },
  { tag: 'Defence command', title: 'Fast onboard alerts', body: 'Threat detection runs onboard. A small alert reaches the ground in seconds, not a video download.' },
];
const useCommercial = [
  { tag: 'Large constellations', title: 'Automatic collision avoidance', body: 'Avoid collisions and hold the orbit slot with no person in the loop.' },
  { tag: 'High-orbit operators', title: 'Protect expensive satellites', body: 'Watch for close approaches and react before they become a problem.' },
  { tag: 'Insurers', title: 'Lower risk, clean exit', body: 'A satellite that can move is a lower risk, and it can deorbit within the 5-year rule.' },
];

// Hero strip: four key numbers. Same values as the spec table on /products/.
const heroStats = [
  { value: '0.1 s', label: 'Detection report rate' },
  { value: '83 km', label: '10 cm object seen in sunlight' },
  { value: '1–5 N', label: 'Pulsed thrust on water' },
  { value: '0', label: 'People in the loop' },
];

// Detect / decide / manoeuvre steps next to the animated scene.
const loop = [
  { title: 'Detect', body: 'Visible, event-based and thermal cameras track nearby objects in sunlight and in eclipse.' },
  { title: 'Decide', body: 'P1S Buddy plans the avoidance manoeuvre onboard. Every command passes a safety shield before it reaches the thruster.' },
  { title: 'Manoeuvre', body: 'P1S PELTAST-X fires. A pulsed combustion mode gives short, strong pulses when the satellite must move.' },
];

// Organization + WebSite structured data. Helps Google show the right name, logo and links.
const homeLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Player One Space',
    alternateName: 'P1S',
    url: 'https://playeronespace.com/',
    logo: 'https://playeronespace.com/icon-512.png',
    description: 'Autonomous defence for satellites. Onboard AI and propulsion that let a satellite detect, decide and manoeuvre with no person in the loop.',
    email: 'dima@playeronespace.com',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Vancouver',
      addressRegion: 'BC',
      addressCountry: 'CA',
    },
    sameAs: [
      'https://www.linkedin.com/company/player-one-space',
      'https://x.com/PlayerOneSpace',
      'https://blog.playeronespace.com/',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Player One Space',
    alternateName: 'P1S',
    url: 'https://playeronespace.com/',
  },
];
---
<BaseLayout
  title="Player One Space — Autonomous Defence For Satellites"
  description="Player One Space builds autonomous defence for satellites. Onboard AI that detects, decides and manoeuvres, with no person in the loop. P1S Buddy is the brain. P1S PELTAST-X is the legs."
  path="/"
  jsonLd={homeLd}
>
  <Hero
    variant="full"
    eyebrow="Onboard AI + Propulsion"
    title="Autonomous<br>defence for<br>satellites"
    sub="Onboard AI that detects, decides and manoeuvres. No person in the loop. P1S Buddy is the brain. P1S PELTAST-X is the legs."
    video="/videos/earth-hero.mp4"
    poster="/images/earth-hero-poster.jpg"
    stats={heroStats}
    statsNote="Modelled and design values. Bench tests confirm them through 2026–2027."
  />

  <Section eyebrow="The Problem" title="Space is getting crowded. Satellites cannot protect themselves.">
    <div class="grid grid--3">
      {problem.map((w) => <ModuleCard tag={w.tag} title={w.title} body={w.body} />)}
    </div>
  </Section>

  <Section eyebrow="How It Works" title="The brain decides.<br>The legs move." alt={true}>
    <p class="lead reveal offset">Reaction drops from hours to seconds. It works even when the link to the ground is jammed.</p>
    <Sequence steps={loop} />
  </Section>

  <Section eyebrow="One Kit. Two Products." title="Two units.<br>One system.">
    <ProductCard
      index="01"
      kicker="Flagship — Onboard Autonomy"
      name="P1S Buddy"
      tagline="Onboard AI Engine"
      trl="TRL 4 · TRL 5–6 by end of 2026"
      body="The onboard AI engine that makes autonomous decisions and delivers real-time intelligence from orbit — no ground loop. It commands propulsion through a safety-bounded interface: our own thruster, or any third-party thruster a satellite already carries."
      href="/products/#buddy"
      image="/images/buddy-front.jpg"
      imageAlt="P1S Buddy camera unit, front view"
      specs={[['Size', '200 × 100 × 175 mm'], ['Mass', '~2.5 kg'], ['Power', '31 W while running']]}
    />
    <ProductCard
      index="02"
      kicker="Propulsion — Built for Buddy"
      name="P1S PELTAST-X"
      tagline="Propulsion Engine"
      trl="TRL 3 · TRL 4–5 by end of 2026"
      body="A water-fuelled hybrid thruster: precise cold-gas modes for routine work and a pulsed combustion mode for short, strong manoeuvres. Launches with 250 mL of plain water, unpressurized. Built for Buddy's command interface."
      href="/products/#plasma"
      image="/images/peltast-x.jpg"
      imageAlt="P1S PELTAST-X 2U thruster module"
      specs={[['Size', '2U, 100 × 100 × 227 mm'], ['Mass', '1.8 kg dry, 2.0 kg with water'], ['Power', '20 W while making gas, 3 W standby']]}
      flip={true}
    />
  </Section>

  <Section eyebrow="Use Cases" title="One kit for defence and commercial." alt={true}>
    <div class="uc reveal">
      <h3 class="uc__head">Defence &amp; government</h3>
      <div class="grid grid--3">
        {useDefence.map((u) => <ModuleCard tag={u.tag} title={u.title} body={u.body} />)}
      </div>
    </div>
    <div class="uc reveal">
      <h3 class="uc__head">Commercial</h3>
      <div class="grid grid--3">
        {useCommercial.map((u) => <ModuleCard tag={u.tag} title={u.title} body={u.body} />)}
      </div>
    </div>
  </Section>

  <Section eyebrow="Market" title="Dual use.<br>A large, open market.">
    <StatRow stats={tam} />
    <p class="src reveal">Sources: US Space Force FY2026 request · SSA market research 2025–2030 · Novaspace 2026. The ~7,400 share is our estimate.</p>
  </Section>

  <Section eyebrow="Why Now" title="The window is open now." alt={true}>
    <p class="lead reveal offset">Within three years, the number of satellites in orbit will more than double. Space is becoming contested, and no ground team can watch that many satellites or react in time. Satellites will need to defend themselves.</p>
    <div class="grid grid--4">
      {whyNow.map((w) => <ModuleCard tag={w.tag} title={w.title} body={w.body} />)}
    </div>
  </Section>

  <Section eyebrow="From the Blog" title="Notes from the edge of space.">
    {posts.length > 0 && (
      <div class="grid grid--3 blog-grid">
        {posts.map((p) => (
          <BlogCard href={p.href} title={p.title} excerpt={p.excerpt} date={p.date} image={p.image} />
        ))}
      </div>
    )}
    <div class="blog-actions reveal">
      <a href="https://blog.playeronespace.com/" target="_blank" rel="noopener" class="btn btn--ghost">Read the Blog</a>
      <a href="https://blog.playeronespace.com/subscribe" target="_blank" rel="noopener" class="btn btn--primary">Subscribe</a>
    </div>
  </Section>

  <section class="cta">
    <img class="cta__img" src="/images/earth.jpg" alt="" loading="lazy" />
    <div class="wrap cta__inner reveal">
      <span class="bracket-label">Next Step</span>
      <h2 class="cta__title">Building what comes after launch.</h2>
      <p class="lead">Detect. Decide. Manoeuvre. The self-defending satellite.</p>
      <a href="/contact/" class="btn btn--primary">Get in Touch</a>
    </div>
  </section>
</BaseLayout>

<style>
  .uc + .uc { margin-top: clamp(2.5rem, 5vw, 4rem); }
  .uc__head {
    font-family: var(--font-mono); font-size: var(--fs-label); font-weight: 500; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--text); margin-bottom: 1.1rem;
    display: flex; align-items: center; gap: 0.7rem;
  }
  .uc__head::before { content: ''; width: 7px; height: 7px; background: var(--accent); }
  .src { margin-top: 1.5rem; font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.04em; color: var(--text-dim); }
  .blog-grid { margin-bottom: 2rem; }
  .blog-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }

  .cta { position: relative; overflow: hidden; border-top: 1px solid var(--line); padding: clamp(6rem, 16vw, 13rem) 0; }
  .cta__img {
    position: absolute; right: -8%; top: 50%; width: min(78vw, 980px); aspect-ratio: 1; transform: translateY(-38%);
    object-fit: cover; opacity: 0.9; pointer-events: none;
    -webkit-mask-image: radial-gradient(closest-side, #000 82%, transparent 100%);
            mask-image: radial-gradient(closest-side, #000 82%, transparent 100%);
  }
  .cta::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, var(--bg) 18%, rgba(6,6,7,0.55) 55%, rgba(6,6,7,0.1) 100%); pointer-events: none; }
  .cta__inner { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: flex-start; }
  .cta__title { font-size: clamp(2.4rem, 6.4vw, 6rem); line-height: 0.95; letter-spacing: -0.05em; max-width: 13ch; margin-bottom: 1.5rem; }
  .cta .lead { margin-bottom: 2rem; color: var(--text); }
</style>
