---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ModuleCard from '../components/ModuleCard.astro';

const buddyModules = [
  { tag: 'M01 — Safe Manoeuvre Engine', title: 'Autonomous collision avoidance', body: 'Takes a conjunction warning, then plans, checks and runs the avoidance manoeuvre onboard. No person in the loop. Every command passes a mathematical safety shield before it reaches the thruster.' },
  { tag: 'M02 — VisNav', title: 'Perception of known objects', body: 'Standard cameras and edge AI track a nearby satellite of known shape: range, 3D pose and velocity. The AI model is designed to run under 5 W. Proximity awareness, inspection, and behaviour characterization.' },
  { tag: 'M03 — Pattern-of-Life + Alert', title: 'Anomaly detection and alerting', body: 'An orbital-mechanics filter flags an object that is actively manoeuvring to match your orbit, and raises a small alert: class, range, vector, confidence. Kilobytes, not gigabytes of video.' },
];

const plasmaStages = [
  { tag: 'P1 — Electrolysis', title: 'Water to H₂/O₂', body: 'The thruster launches with 250 mL of plain water, unpressurized. On board, it splits the water into hydrogen and oxygen. No toxic propellant.' },
  { tag: 'P2 — Hybrid Thrust', title: 'Cold gas plus pulsed combustion', body: 'Four modes. H₂, O₂ and mixed cold gas handle fine control and routine work. A pulsed combustion mode gives short, strong pulses when the satellite must move. Moderate thrust: ~8–40 mN cold gas · 1–5 N pulsed.' },
  { tag: 'P3 — 1U–2U Form Factor', title: 'Sized for small satellites', body: 'The whole tank-to-thrust unit fits a 1U–2U bay, with a structure under 1.5 kg. It works with satellites of any mass.' },
];
---
<BaseLayout
  title="Technology — Player One Space"
  description="P1S Buddy, the onboard AI engine, and P1S PELTAST-X, a water-fuelled hybrid thruster. Detect, decide, manoeuvre. No person in the loop."
  path="/technology"
>
  <Hero
    eyebrow="Technology"
    title="Detect. Decide.<br>Manoeuvre."
    sub="One kit, two products. The brain sees the threat and decides. The legs move the satellite out of the way. No person in the loop."
  />

  <Section eyebrow="Buddy" title="The onboard AI engine.">
    <p class="lead reveal" style="margin-bottom: 2.5rem;">One AI computer with up to 6 camera modules that sees 360°. It decides onboard, in seconds, with no ground loop. Software updates are sent up from the ground.</p>
    <div class="grid grid--3">
      {buddyModules.map((m) => <ModuleCard tag={m.tag} title={m.title} body={m.body} />)}
    </div>
  </Section>

  <Section eyebrow="PELTAST-X" title="Water propulsion.<br>Safe to launch." alt={true}>
    <p class="lead reveal" style="margin-bottom: 2.5rem;">Plain water is not toxic and not under pressure at launch. It ships as standard cargo, with no special handling.</p>
    <div class="grid grid--3" style="margin-bottom: 3rem;">
      {plasmaStages.map((m) => <ModuleCard tag={m.tag} title={m.title} body={m.body} />)}
    </div>
    <div class="reveal" style="overflow-x:auto;">
      <table class="dtable">
        <thead><tr><th>Propellant</th><th>Launch classification</th></tr></thead>
        <tbody>
          <tr><td>Hydrazine</td><td>HAZMAT Class 6.1, toxic</td></tr>
          <tr><td>Xenon</td><td>High-pressure vessel</td></tr>
          <tr><td>Iodine</td><td>Corrosive, special manifesting</td></tr>
          <tr class="row-hi"><td>Water</td><td>Non-hazardous, standard cargo</td></tr>
        </tbody>
      </table>
    </div>
    <div class="reveal" style="overflow-x:auto; margin-top: 3rem;">
      <table class="dtable">
        <thead><tr><th>P1S PELTAST-X at a glance</th><th>Design target</th></tr></thead>
        <tbody>
          <tr><td>Propellant</td><td>250 mL of plain water, unpressurized at launch</td></tr>
          <tr><td>Modes</td><td>H₂ cold gas · O₂ cold gas · mixed cold gas · pulsed combustion</td></tr>
          <tr><td>Thrust</td><td>~8–40 mN cold gas · 1–5 N pulsed</td></tr>
          <tr><td>Size</td><td>1U–2U</td></tr>
          <tr><td>Structure mass</td><td>&lt; 1.5 kg</td></tr>
          <tr><td>Power</td><td>20 W at up to 40% duty cycle</td></tr>
          <tr><td>Gas store refill</td><td>~4.5 minutes</td></tr>
          <tr><td>Valve response</td><td>2–5 ms</td></tr>
          <tr class="row-hi"><td>Readiness</td><td>TRL 3 today. TRL 4–5 by the end of 2026. Flight proven in 2028.</td></tr>
        </tbody>
      </table>
    </div>
  </Section>

  <Section eyebrow="Roadmap" title="Up to TRL 6 by end of 2026.<br>Flight proven by 2028.">
    <p class="lead reveal" style="margin-bottom: 2.5rem;">AI flight proven in 2027. Full system flight proven in 2028.</p>
    <div class="reveal" style="overflow-x:auto;">
      <table class="dtable">
        <thead><tr><th>Product</th><th>Today</th><th>End of 2026</th><th>In orbit</th><th>Flight proven</th></tr></thead>
        <tbody>
          <tr><td>P1S Buddy · AI module</td><td>TRL 4</td><td>TRL 5–6</td><td>December 2027</td><td>TRL 9 · 2027</td></tr>
          <tr><td>P1S PELTAST-X · Propulsion</td><td>TRL 3</td><td>TRL 4–5</td><td>Mid-2028</td><td>TRL 9 · 2028</td></tr>
          <tr class="row-hi"><td>Buddy + PELTAST-X · Integrated system</td><td>TRL 3</td><td>TRL 4–5</td><td>Mid-2028</td><td>TRL 9 · 2028</td></tr>
        </tbody>
      </table>
    </div>
  </Section>

  <Section eyebrow="The Combined System" title="The self-defending satellite." alt={true}>
    <div class="flow reveal">
      <span class="flow__step display">Buddy sees a threat</span>
      <span class="flow__arrow">→</span>
      <span class="flow__step display">classifies it</span>
      <span class="flow__arrow">→</span>
      <span class="flow__step display">sends the alert</span>
      <span class="flow__arrow">→</span>
      <span class="flow__step flow__step--hi display">PELTAST-X fires, satellite evades</span>
    </div>
    <p class="lead reveal" style="margin-top: 2rem;">No ground loop. No person in the chain. The AI never drives the thruster directly. It asks for a manoeuvre, and a validated propulsion controller runs it inside a safe envelope. The same interface works with our thruster or a third-party thruster the satellite already carries.</p>
  </Section>
</BaseLayout>

<style>
  .flow { display: flex; flex-wrap: wrap; align-items: center; gap: 0.85rem; }
  .flow__step {
    font-size: var(--fs-sm); letter-spacing: 0.04em; text-transform: uppercase;
    padding: 0.6rem 1rem; border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--surface); color: var(--text-muted);
  }
  .flow__step--hi { border-color: var(--accent-line); color: var(--accent); background: var(--accent-dim); }
  .flow__arrow { color: var(--accent); font-size: 1.1rem; }
</style>
