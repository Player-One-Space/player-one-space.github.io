---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ModuleCard from '../components/ModuleCard.astro';

const buddyModules = [
  { tag: 'M01 — VisNav', title: 'Optical relative navigation', body: 'A COTS camera and edge visual AI isolate an approaching object against the starfield — range, 3D pose, and velocity vector, under 5 watts. No radar.' },
  { tag: 'M02 — Pattern-of-Life', title: 'Anomaly detection', body: 'An orbital-mechanics filter tells passive debris from an adversarial inspector that is actively manoeuvring to match your orbit. It spots the difference instantly.' },
  { tag: 'M03 — Panic Packet', title: 'Low-latency alert', body: 'A kilobyte-scale alert — threat class, range, vector, confidence — routed in seconds. No gigabytes of video, no ground round-trip.' },
];

const plasmaStages = [
  { tag: 'P1 — Electrolysis', title: 'Water to H₂/O₂', body: 'Water is split on-board into hydrogen and oxygen. No stored high-pressure gas, no toxic propellant.' },
  { tag: 'P2 — Micro-Arcjet', title: 'Pulsed arc heating', body: 'A solid-state Marx generator drives a pulsed micro-arc that heats the gas; a converging–diverging nozzle turns that heat into thrust. Target: 5–15 mN at 250–350 s specific impulse — roughly ten times the thrust of electric thrusters that fit the same volume.' },
  { tag: 'P3 — 1U Form Factor', title: 'Fits any CubeSat', body: 'The whole tank-to-thrust subsystem fits a 1U bay. Larger platforms are served by scaling the propellant load — the physics is unchanged, the tank grows.' },
];
---
<BaseLayout
  title="Technology — Player One Space"
  description="The integrated stack: Buddy, the onboard AI engine, and Plasma water-electrolysis propulsion. Detect, classify, respond — autonomously."
  path="/technology"
>
  <Hero
    eyebrow="Technology"
    title="Detect. Classify. Evade.<br>Autonomously."
    sub="Two products, one integrated stack. The brain that sees the threat, and the legs that move the satellite out of the way — with no human in the loop."
  />

  <Section eyebrow="Buddy" title="The onboard AI engine.">
    <p class="lead reveal" style="margin-bottom: 2.5rem;">A unified onboard AI engine — hardware-agnostic, updatable over the air. It makes autonomous decisions and delivers real-time intelligence from orbit. Flagship capability: it classifies threats before the ground even wakes up.</p>
    <div class="grid grid--3">
      {buddyModules.map((m) => <ModuleCard tag={m.tag} title={m.title} body={m.body} />)}
    </div>
  </Section>

  <Section eyebrow="Plasma" title="Water propulsion.<br>Safe to launch." alt={true}>
    <p class="lead reveal" style="margin-bottom: 2.5rem;">Water is the only propellant that is non-hazardous on launch and exists naturally across the solar system. It ships as standard cargo and refuels anywhere there is ice.</p>
    <div class="grid grid--3" style="margin-bottom: 3rem;">
      {plasmaStages.map((m) => <ModuleCard tag={m.tag} title={m.title} body={m.body} />)}
    </div>
    <div class="reveal" style="overflow-x:auto;">
      <table class="dtable">
        <thead><tr><th>Propellant</th><th>Launch classification</th><th>Cost / kg</th></tr></thead>
        <tbody>
          <tr><td>Hydrazine</td><td>HAZMAT Class 6.1 — toxic</td><td>$1,800–3,000</td></tr>
          <tr><td>Xenon</td><td>High-pressure vessel</td><td>$1,500–2,500</td></tr>
          <tr><td>Iodine</td><td>Corrosive — special manifesting</td><td>$300–800</td></tr>
          <tr class="row-hi"><td>Water</td><td>Non-hazardous — standard cargo</td><td>Under $1/kg</td></tr>
        </tbody>
      </table>
    </div>
  </Section>

  <Section eyebrow="The Combined System" title="The self-defending satellite.">
    <div class="flow reveal">
      <span class="flow__step display">Buddy sees a threat</span>
      <span class="flow__arrow">→</span>
      <span class="flow__step display">classifies it</span>
      <span class="flow__arrow">→</span>
      <span class="flow__step display">sends the alert</span>
      <span class="flow__arrow">→</span>
      <span class="flow__step flow__step--hi display">Plasma fires, satellite evades</span>
    </div>
    <p class="lead reveal" style="margin-top: 2rem;">No ground loop. No human in the chain. And the AI never touches the plasma directly — it requests a maneuver, and a validated propulsion controller executes it inside a safety envelope. That interface is propulsion-agnostic: it commands our own thruster or a third-party thruster a satellite already carries.</p>
  </Section>
</BaseLayout>

<style>
  .flow { display: flex; flex-wrap: wrap; align-items: center; gap: 0.85rem; }
  .flow__step {
    font-size: var(--fs-sm); letter-spacing: 0.04em; text-transform: uppercase;
    padding: 0.6rem 1rem; border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--surface); color: var(--text-muted);
  }
  .flow__step--hi { border-color: var(--accent-line); color: var(--accent); background: var(--accent-dim); }
  .flow__arrow { color: var(--accent); font-size: 1.1rem; }
</style>
